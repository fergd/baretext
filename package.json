{
  "name": "baretext",
  "version": "1.0.0",
  "description": "A distraction-free writing app",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac",
    "build:editor": "esbuild src/editor/index.js --bundle --minify --format=iife --loader:.aff=text --loader:.dic=text --outfile=src/editor-bundle.js",
    "test:unit": "node --test test/unit/*.test.js",
    "test:e2e": "node --test test/e2e/*.test.js",
    "test": "npm run test:unit && npm run test:e2e"
  },
  "build": {
    "appId": "com.baretext.app",
    "productName": "Baretext",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "src/icon.icns",
      "category": "public.app-category.productivity",
      "target": "dir"
    }
  },
  "devDependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.7.2",
    "electron": "^28.3.3",
    "electron-builder": "24.13.3",
    "esbuild": "^0.28.1",
    "nspell": "^2.1.5"
  }
}
