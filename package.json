{
  "name": "baretext",
  "version": "2.0.0",
  "private": true,
  "description": "Distraction-free writing for Mac",
  "main": "build/main/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "bench": "npm run build && playwright test --config playwright.bench.config.ts",
    "lint": "oxlint --type-aware app packages",
    "gallery": "npm run build && BARETEXT_GALLERY=1 electron .",
    "dist": "npm run build && electron-builder --mac"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "docx": "^9.8.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "fast-check": "^4.10.2",
    "happy-dom": "^20.14.5",
    "jszip": "^3.10.2",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.0",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.12",
    "prosemirror-state": "^1.4.4",
    "prosemirror-transform": "^1.12.2",
    "prosemirror-view": "^1.42.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "type": "module",
  "productName": "Baretext"
}
